SPEECH_PROVIDER=aliyun
ALIYUN_API_KEY=your_aliyun_bailian_api_key_here
ALIYUN_ASR_MODEL=fun-asr
ALIYUN_ASR_DIARIZATION_ENABLED=true
ALIYUN_ASR_SPEAKER_COUNT=

RECORD_RETENTION_DAYS=30
OSS_AUDIO_RETENTION_DAYS=7

# optional OSS direct upload test / customer-owned OSS
# Keep disabled by default. Enable when testing or when the customer provides their own OSS.
OSS_ENABLED=false
OSS_BUCKET=your_oss_bucket_here
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
OSS_DIR=meeting-audio
OSS_EXPIRES_SECONDS=21600

# optional server-side OSS fallback, disabled by default
ALIYUN_OSS_ENABLED=false
ALIYUN_OSS_BUCKET=your_oss_bucket_here
ALIYUN_OSS_REGION=cn-hangzhou
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
ALIYUN_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
ALIYUN_OSS_DIR=meeting-audio
ALIYUN_OSS_EXPIRES_SECONDS=21600

LLM_PROVIDER=qwen
QWEN_API_KEY=your_aliyun_bailian_api_key_here
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# optional fallback: deepseek
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-chat

# optional overseas fallback
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.5
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
