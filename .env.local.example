SPEECH_PROVIDER=local
LOCAL_PYTHON_PATH=python3
LOCAL_ASR_MODEL=SenseVoiceSmall
LOCAL_ASR_DEVICE=cpu
MODELSCOPE_PYTHON_PATH=
MODELSCOPE_SPEAKER_COUNT=

RECORD_RETENTION_DAYS=30
OSS_AUDIO_RETENTION_DAYS=7

# optional upload fallback, keep disabled by default
OSS_ENABLED=false
OSS_BUCKET=your_oss_bucket_here
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
OSS_DIR=meeting-audio
OSS_EXPIRES_SECONDS=21600

LLM_PROVIDER=local
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_LLM_DEVICE_MAP=auto
